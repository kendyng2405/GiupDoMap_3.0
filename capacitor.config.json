{
  "appId": "online.traitimviet.app",
  "appName": "Trái Tim Việt",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "hostname": "traitimviet.online"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#9B111E",
